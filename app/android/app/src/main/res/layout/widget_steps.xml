<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ws_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/ws_lbl"
            android:fontFamily="@font/nr_heebo_bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#A3ADA6"
            android:textSize="12sp"
            android:maxLines="1"
            android:text="צעדים" />
        <TextView
            android:id="@+id/ws_pct"
            android:fontFamily="@font/nr_sora_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#5AC8FA"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>
    <TextView
        android:id="@+id/ws_steps"
        android:fontFamily="@font/nr_sora_bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#F2F5F1"
        android:textSize="30sp"
        android:maxLines="1"
        android:text="—" />
    <TextView
        android:id="@+id/ws_of"
        android:fontFamily="@font/nr_heebo_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#A3ADA6"
        android:textSize="11sp"
        android:maxLines="1" />
    <ProgressBar
        android:id="@+id/ws_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_bar_blue" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/ws_meta"
        android:fontFamily="@font/nr_heebo_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#A3ADA6"
        android:textSize="11sp"
        android:maxLines="1" />
</LinearLayout>
