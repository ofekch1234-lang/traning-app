<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_kcal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F2F5F1"
            android:textSize="30sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="—" />
        <TextView
            android:id="@+id/w_kcal_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A3ADA6"
            android:textSize="12sp"
            android:maxLines="1"
            android:text="קק״ל נותרו" />
        <ProgressBar
            android:id="@+id/w_kcal_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_bar" />
        <ProgressBar
            android:id="@+id/w_kcal_bar_f"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressDrawable="@drawable/widget_bar_f" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="#1F2420" />

    <LinearLayout
        android:id="@+id/w_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.25"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_prot_lbl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#A3ADA6"
                android:textSize="12sp"
                android:maxLines="1"
                android:text="חלבון" />
            <TextView
                android:id="@+id/w_prot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F2F5F1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/w_prot_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_bar" />
        <ProgressBar
            android:id="@+id/w_prot_bar_f"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressDrawable="@drawable/widget_bar_f" />
        <TextView
            android:id="@+id/w_next_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#BFFF2F"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="האימון הבא" />
        <TextView
            android:id="@+id/w_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F2F5F1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/w_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#A3ADA6"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
