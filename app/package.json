{
  "name": "nextrep-native",
  "private": true,
  "version": "1.0.0",
  "description": "NextRep iOS/Android shell (Capacitor). The web app itself lives at the repo root.",
  "scripts": {
    "web": "node scripts/copy-web.js",
    "sync": "npm run web && npx cap sync",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#BFFF2F' --iconBackgroundColorDark '#BFFF2F' --splashBackgroundColor '#0A0B0A' --splashBackgroundColorDark '#0A0B0A'"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "7.1.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-social-login": "8.7.5",
    "@revenuecat/purchases-capacitor": "13.7.6",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3"
  }
}
